{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ipubca.dev/schemas/pyq-import.schema.json",
  "title": "PYQ Import Document (ipubca shared format)",
  "type": "object",
  "required": ["schemaVersion", "course", "semester", "subject", "questions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "course": {
      "type": "object",
      "required": ["name", "code"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,14}$" }
      }
    },
    "semester": { "type": "integer", "minimum": 1, "maximum": 12 },
    "subject": {
      "type": "object",
      "required": ["name", "code"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,14}$" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "year", "unit", "questionNumber", "questionText", "questionType", "marks"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Stable id within this subject. Not assumed globally unique." },
          "year": { "type": "integer", "minimum": 1980, "maximum": 2100 },
          "unit": { "type": "integer", "minimum": 1, "maximum": 12 },
          "topic": { "type": "string", "minLength": 1, "maxLength": 100 },
          "questionNumber": { "type": "string", "minLength": 1, "maxLength": 50 },
          "questionText": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "questionType": { "type": "string", "enum": ["very_short", "short", "mcq", "long"] },
          "marks": { "type": "integer", "minimum": 0, "maximum": 100 },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
