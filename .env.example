# ── Appwrite connection (server-side ONLY — never ship these to a browser) ──
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=server-a-p…only

# ── Database ──
APPWRITE_DATABASE_ID=pyq_platform

# ── Collections ──
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_COURSES=courses
APPWRITE_COLLECTION_SEMESTERS=semesters
APPWRITE_COLLECTION_SUBJECTS=subjects
APPWRITE_COLLECTION_UNITS=units
APPWRITE_COLLECTION_TOPICS=topics
APPWRITE_COLLECTION_QUESTIONS=questions
APPWRITE_COLLECTION_ANSWERS=answerSubmissions
APPWRITE_COLLECTION_REPORTS=reports
APPWRITE_COLLECTION_IMPORTS=importJobs

# ── Storage buckets ──
APPWRITE_BUCKET_ANSWER_IMAGES=answer_images
APPWRITE_BUCKET_PYQ_IMPORTS=pyq_imports

# ── Admin team (used for server-side role checks) ──
APPWRITE_ADMIN_TEAM_ID=pyqadmins

# ── Function IDs ──
APPWRITE_FUNCTION_IMPORT_PYQ_JSON=importpyqjson
APPWRITE_FUNCTION_CREATE_ANSWER=createanswersubmission
APPWRITE_FUNCTION_PUBLISH_ANSWER=publishanswer
APPWRITE_FUNCTION_REJECT_ANSWER=rejectanswer
APPWRITE_FUNCTION_DELETE_ANSWER=deleteanswer
APPWRITE_FUNCTION_REPORT_ANSWER=reportanswer
APPWRITE_FUNCTION_ADMIN_USERS=adminusermanagement
APPWRITE_FUNCTION_CLEANUP_ORPHANS=cleanuporphanedfiles

# ── Public values the React frontend needs (these are safe to expose) ──
# Put a copy of ONLY these into the frontend's .env
VITE_APPWRITE_ENDPOINT=${APPWRITE_ENDPOINT}
VITE_APPWRITE_PROJECT_ID=${APPWRITE_PROJECT_ID}
VITE_APPWRITE_DATABASE_ID=${APPWRITE_DATABASE_ID}
